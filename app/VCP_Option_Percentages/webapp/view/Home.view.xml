<mvc:View
    xmlns:smartfilterbar="sap.ui.comp.smartfilterbar"
    xmlns:core="sap.ui.core"
    xmlns:variants="sap.ui.fl.variants"
    xmlns:form="sap.ui.layout.form"
    xmlns:filterbar="sap.ui.comp.filterbar"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns:table="sap.ui.table"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:smartvariants="sap.ui.comp.smartvariants"
    xmlns:l="sap.ui.layout"
    xmlns:html="http://www.w3.org/1999/xhtml"
    controllerName="vcpapp.vcpoptionpercentage.controller.Home"
>
    <Page
        title="{i18n>title}"
        titleAlignment="Center"
        showHeader="false"
    >
        <content>
            <l:Splitter
                height="100%"
                resize="onSplitResize"
            >
                <f:DynamicPage
                    id="idDynamicPage"
                    headerExpanded="{/headerExpanded}"
                    toggleHeaderOnTitleClick="{/titleClickable}"
                >
                    <f:layoutData>
                        <l:SplitterLayoutData
                            id="idMasterPage"
                            size="25%"
                            resizable="false"
                        />
                    </f:layoutData>
                    <f:title>
                        <f:DynamicPageTitle>
                            <f:heading>
                                <VariantManagement
                                    xmlns="sap.m"
                                    id="idMatList123"
                                    select="handleSelectPress"
                                    save="onCreate"
                                    manage="onManage"
                                    supportFavorites="false"
                                    showFooter="true"
                                    popoverTitle="My Views"
                                    items="{path: '/variants'}"
                                    creationAllowed="true"
                                    supportPublic="true"
                                    supportApplyAutomatically="false"
                                    manageCancel="onManageCancel"
                                    cancel="onNameCancel"
                                    visible="true"
                                >
                                    <items>
                                        <VariantItem
                                            key="{VARIANTID}"
                                            text="{VARIANTNAME}"
                                            author="{USER}"
                                            visible="true"
                                            remove="true"
                                            sharing="{SCOPE}"
                                            changeable="{path:'CHANGE', formatter:'.formatter.formatChange'}"
                                            rename="false"
                                            enabled="{path:'ENABLE', formatter:'.formatter.formatEnable'}"
                                        />
                                    </items>
                                </VariantManagement>
                            </f:heading>
                            <f:actions>
                                <Button
                                    class="classHdr"
                                    icon="sap-icon://sys-help"
                                    id="idNav3PRD"
                                    press="onNavPress"
                                    type="Emphasized"
                                    tooltip="Help Document"
                                />
                            </f:actions>
                        </f:DynamicPageTitle>
                    </f:title>
                    <f:header>
                        <f:DynamicPageHeader pinnable="true">
                            <smartfilterbar:SmartFilterBar
                                id="smartFilterBar"
                                entitySet="getOptFilterdata"
                                showClearOnFB="true"
                                useToolbar="false"
                                filterChange="onFilterChange"
                                showFilterConfiguration="false"
                                initialized="onFilterBarInit"
                                search="onGo"
                                clear = "onClear"
                              
                              
                            >
                                <smartfilterbar:controlConfiguration>
                                    <smartfilterbar:ControlConfiguration
                                        key="LOCATION_ID"
                                        label="Demand Location"
                                    >
                                        <!-- <smartfilterbar:defaultFilterValues>   clear="onClear" 
                                            <smartfilterbar:SelectOption
                                                low="1600"
                                                operator="EQ"
                                            />
                                        </smartfilterbar:defaultFilterValues> -->
                                    </smartfilterbar:ControlConfiguration>
                                    <smartfilterbar:ControlConfiguration
                                     mandatory="mandatory"
                                        filterType="single"
                                        controlType="auto"
                                        key="PRODUCT_ID"
                                        label="Products"
                                    >
                                        <!-- <smartfilterbar:defaultFilterValues>
                                            <smartfilterbar:SelectOption
                                                low="VCP_1600"
                                                operator="EQ"
                                            />
                                        </smartfilterbar:defaultFilterValues> -->
                                    </smartfilterbar:ControlConfiguration>
                                    <smartfilterbar:ControlConfiguration
                                        key="CUSTOMER_GROUP"
                                        label="Customer Group"
                                    />

                                    <smartfilterbar:ControlConfiguration 
                                        key="CHAR_NUM"
                                        label="Characteristic"
                                    >
                                    <!-- <smartfilterbar:defaultFilterValues>
                                            <smartfilterbar:SelectOption
                                                low="0000000951"
                                                operator="EQ"
                                            />
                                        </smartfilterbar:defaultFilterValues>
                                    </smartfilterbar:ControlConfiguration> -->

                                       </smartfilterbar:ControlConfiguration>
                                    

                                    <smartfilterbar:ControlConfiguration
                                        key="CHARVAL_NUM"
                                    />
                                    <smartfilterbar:ControlConfiguration
                                        key="VERSION_NAME"
                                        mandatory="mandatory"
                                        filterType="single"
                                        controlType="auto"
                                    >
                                        <smartfilterbar:defaultFilterValues>
                                            <smartfilterbar:SelectOption
                                            id = "Vers"
                                                low="Base Version"
                                                operator="EQ"
                                            />
                                        </smartfilterbar:defaultFilterValues>
                                    </smartfilterbar:ControlConfiguration>
                                    <smartfilterbar:ControlConfiguration
                                        key="SCENARIO_NAME"
                                        mandatory="mandatory"
                                        filterType="single"
                                        controlType="auto"
                                    >
                                        <smartfilterbar:defaultFilterValues>
                                            <smartfilterbar:SelectOption
                                                low="_PLAN"
                                                operator="EQ"
                                            />
                                        </smartfilterbar:defaultFilterValues>
                                    </smartfilterbar:ControlConfiguration>
                                    <smartfilterbar:ControlConfiguration
                                        label="Model Version"
                                        mandatory="mandatory"
                                        key="MODEL_VERSION"
                                        controlType="dropDownList"
                                        filterType="single"
                                    >
                                        <smartfilterbar:defaultFilterValues>
                                            <smartfilterbar:SelectOption
                                                low="Active"
                                                operator="EQ"
                                            />
                                        </smartfilterbar:defaultFilterValues>
                                    </smartfilterbar:ControlConfiguration>
                                    <smartfilterbar:ControlConfiguration
                                        label="Valid Between"
                                        mandatory="mandatory"
                                        key="WEEK_DATE"
                                        controlType="auto"
                                    >
                                        <smartfilterbar:customControl>
                                            <DateRangeSelection
                                                id="idWeekDate"
                                                delimiter="-"
                                                displayFormat="yyyy-MM-dd"
                                            />
                                        </smartfilterbar:customControl>
                                    </smartfilterbar:ControlConfiguration>
                                </smartfilterbar:controlConfiguration>
                            </smartfilterbar:SmartFilterBar>
                        </f:DynamicPageHeader>
                    </f:header>
                    <f:content>
                        <Panel>
                            <!-- <HBox> -->
                            <SearchField
                                id="idSearchField"
                                width="100%"
                                liveChange="onSearch"
                            />
                            <!-- <Button id="treeExpandCollapse" text="Expand" press="onExpandCollapse" visible="false"></Button> -->
                            <!-- </HBox> -->
                            <Tree
                                id="idTree"
                                selectionChange="onTreeItemSelect"
                                busy="false"
                                busyIndicatorDelay="0"
                                mode="SingleSelectMaster"
                                items="{path: 'treeModel>/items',parameters: {arrayNames: ['products','chars','charvals'],numberOfExpandedLevels: 1}}"
                            >
                                <StandardTreeItem
                                    title="{treeModel>description}"
                                    highlightText="{treeModel>description}"
                                  
                                />
                            </Tree>
                        </Panel>
                    </f:content>
                </f:DynamicPage>
                <Page
                    id="idDynamicPage2"
                    showFooter="false"
                    busyIndicatorDelay="0"
                >
                    <headerContent>
                      
                        <Label text="Periodic Display : " />
                        <!-- <Select
                            id="idWeekType"
                            change="onWeekTypeChange"
                            enabled="true"
                        >
                            <items>
                                <core:Item
                                    text="Telescopic View"
                                    key="TELESCOPIC_WEEK"
                                />
                                <core:Item
                                    text="Calendar View"
                                    key="CALENDAR_WEEK"
                                />
                            </items>
                        </Select> -->
                        <!-- <HBox alignItems="Center">
    <Text id="idWeekLabel" text="Telescopic View" class="sapUiSmallMarginEnd" />
    <Switch
        id="idWeekTypeSwitch"
        state="false"
        change="onWeekTypeChange"
    />
</HBox> -->

<SegmentedButton
    id="idWeekType"
    selectionChange="onWeekTypeChange"
>
    <items>
        <SegmentedButtonItem
            key="TELESCOPIC_WEEK"
            text="Telescopic View"
            pressed="true" />
        <SegmentedButtonItem
            key="CALENDAR_WEEK"
            text="Calendar View" />
    </items>
</SegmentedButton>

  <ToolbarSpacer />


                        <Label text="Version : " />
                        <Input
                            id="idVerInput"
                            editable="false"
                            width="10rem"
                        />
                        <Label text="Scenario : " />
                        <Input
                            id="idScenInput"
                            editable="false"
                            width="10rem"
                        />
                        <!-- <CheckBox id="idPri" select="selectPriorityChek" text="Show All Characteristics" selected="false" enabled="false"></CheckBox> -->
                        <Button
                            id="idColConfig"
                            tooltip="Customize Columns"
                            icon="sap-icon://customize"
                            press="onColSettings"
                        />
                        <Button
                            id="idKeyFigSort"
                            tooltip="Sort Key Figure"
                            icon="sap-icon://sort"
                            press="onOpenKeyFigPopup"
                        />
                        <!-- <SegmentedButton id="idSegBtn" selectionChange="onSegBtnChange">
                            <items>
                                <SegmentedButtonItem id="idOptPer" text="Option %" key="Percent"/>
                                <SegmentedButtonItem id="idOptQty" text="Option Quantity" key="Quantity"/>
                            </items>
                        </SegmentedButton> -->
                        <Button
                            id="idFullScreen"
                            icon="sap-icon://full-screen"
                            press="handleFullScreen"
                            tooltip="Enter Full Screen Mode"
                        />
                    </headerContent>
                    <content>
                        <Panel
                            expandable="true"
                            expanded="false"
                            expandAnimation="true"
                            height="auto"
                            expand="onPanelExpand"
                        >
                            <headerToolbar>
                                <OverflowToolbar>
                                    <ToolbarSpacer />
                                    <Button
                                        type="Ghost"
                                        text="Update Product Demand"
                                        press="handleEditMenu"
                                        enabled="{= ${oGModel>/hasCustomerGroup}}"
                                    />
                                    <!-- <Button type="Ghost" text="Save Product Demand" press="onSaveProductDemand" enabled="{= ${oGModel>/subDataChanges}.length > 0 }"/> -->
                                </OverflowToolbar>
                            </headerToolbar>
                            <content>
                                <html:div id="subDiv" />
                            </content>
                        </Panel>
                        <html:div id="mainDiv" />
                    </content>
                    <footer>
                        <Bar>
                            <contentRight>
                                <Label text="Sum :" />
                                <Text
                                    id="idSumTag"
                                    text="{sumModel>/sum}"
                                />
                                <Button
                                    type="Ghost"
                                    text="Simulate"
                                    press="onSimulateChanges"
                                />
                                <Button
                                    type="Emphasized"
                                    text="Save"
                                    press="onSaveExcel"
                                />
                                <Button
                                    type="Neutral"
                                    text="Refresh"
                                    icon="sap-icon://refresh"
                                    press="onRefreshExcel"
                                />
                            </contentRight>
                        </Bar>
                    </footer>
                </Page>
            </l:Splitter>
        </content>
    </Page>
</mvc:View>
