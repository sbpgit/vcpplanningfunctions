<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="uniqueIdDialog"
        title="Unique Configuration"
        class="sapUiSizeCompact"
        stretch="{device>/system/phone}"
        contentHeight="400px"
        contentWidth="800px">
        <VBox class="sapUiSmallMargin">
            <SearchField
                width="100%"
                id="uniqueIdSearchField"
                liveChange="onUniqueIdSearch"
                placeholder="Characteristic Name/ Characteristic Value" />
            <Table
                id="tblUniqueId"
                inset="false"
                growing="true"
                items="{
                    path: 'uniqueIdModel>/data'
                }">
                <columns>
                    <Column width="180px"><Text text="Characteristic Name" /></Column>
                    <Column><Text text="Char Description" /></Column>
                    <Column><Text text="Char Value" /></Column>
                    <Column><Text text="CharVal Description" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{uniqueIdModel>CHAR_NAME}" wrapping="false" />
                            <Text text="{uniqueIdModel>CHAR_DESC}" />
                            <Text text="{uniqueIdModel>CHAR_VALUE}" />
                            <Text text="{uniqueIdModel>CHARVAL_DESC}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
        <beginButton>
            <Button text="Close" press="onUniqueIdCancel" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
