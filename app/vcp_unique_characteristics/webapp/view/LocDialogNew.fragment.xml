<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog type="Standard" title="{i18n>loc}" contentWidth="400px" id="idloc1UC">
		<content>
			<Table id="LocSlctList1UC" mode="SingleSelectMaster" growing="true" growingDirection="Downwards" growingScrollToLoad="true"
                     items="{path: '/results'}" selectionChange="handleSelection" sticky="ColumnHeaders" rememberSelections="false">
				<headerToolbar>
					<Toolbar>
						<ToolbarSpacer/>
						<SearchField id="LocSearch1UC"  liveChange="handleSearch1"  placeholder="{i18n>loc}"/>
					</Toolbar>
				</headerToolbar>
				<columns>
					<Column hAlign="Begin" vAlign="Middle" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" >
						<Text text="{i18n>loc}"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<ObjectIdentifier title="{DEMAND_LOC}" text="{DEMAND_DESC}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<!-- <beginButton>
			<Button type='Accept' text="{i18n>submit}" press="handleSelection"></Button>
		</beginButton> -->
		<endButton>
			<Button type='Reject' text="{i18n>close}" press="handleClose"></Button>
		</endButton>
	</Dialog>
</core:FragmentDefinition>