<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <TableSelectDialog
        id="idcharDialogOPMIXP"
        title="Characteristic"
        multiSelect="true"
        rememberSelections="true"
        growing="true"
        growingThreshold="200"
        search="handleSearch"
        liveChange="onAllSearch"
        confirm="onConfirmSelection"
        cancel="handleClose"
        selectionChange="onSelProd"
        items="{path: '/items', sorter: { path: 'CHAR_NUM' }}"
        contentWidth="300px">

        <columns>
            <Column>
                <Text text="Characteristic"/>
            </Column>
        </columns>

        <!--  MUST be inside items -->
        <items>
            <ColumnListItem>
                <ObjectIdentifier
                    title="{CHAR_DESC}"
                    text="{CHAR_NUM}" />
            </ColumnListItem>
        </items>

    </TableSelectDialog>
</core:FragmentDefinition>
