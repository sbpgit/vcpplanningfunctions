<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="graphFullDialog"
            title="Graph Fullscreen"
            stretch="true"
            showHeader="true">

        <content>
            <VBox id="fullScreenGraphContainer" width="100%" height="100%"/>
        </content>

        <endButton>
            <Button text="Close" press=".onCloseGraphFullscreen"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>