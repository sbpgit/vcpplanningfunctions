<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

    <Dialog 
        id="idMsgForCustGrpDialogOPMIXP"
        title="Please Select Customer Group"
        resizable="true">

        <content>
            <List 
                id="custList"
                mode="SingleSelectMaster"
                items="{/items}">

                <StandardListItem 
                    title="{CUSTOMER_GROUP}"  />
            </List>
        </content>

        <!-- ✅ Your Custom Buttons -->
        <beginButton>
            <Button 
                text="Confirm" 
                press=".onConfirmToSimulate"/>
        </beginButton>

        <endButton>
            <Button 
                text="Close" 
                press=".onCloseDialog"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>